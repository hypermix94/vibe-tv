<?xml version="1.0" encoding="utf-8"?>
<!-- Wi-Fi: on focus the signal fills up, from the dot out to the widest arc. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
            <path android:name="arc3" android:pathData="M2.5,9A13.5,13.5 0 0 1 21.5,9" android:strokeColor="#FFFFFFFF"
                android:strokeWidth="2" android:strokeLineCap="round" />
            <path android:name="arc2" android:pathData="M5.8,12.4A8.8,8.8 0 0 1 18.2,12.4" android:strokeColor="#FFFFFFFF"
                android:strokeWidth="2" android:strokeLineCap="round" />
            <path android:name="arc1" android:pathData="M9.1,15.8A4.1,4.1 0 0 1 14.9,15.8" android:strokeColor="#FFFFFFFF"
                android:strokeWidth="2" android:strokeLineCap="round" />
            <path android:name="dot" android:pathData="M12,18.2m-1.5,0a1.5,1.5 0 1,0 3,0a1.5,1.5 0 1,0 -3,0"
                android:fillColor="#FFFFFFFF" />
        </vector>
    </aapt:attr>
    <target android:name="dot">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0.2" android:valueTo="1"
                android:valueType="floatType" android:duration="375" />
        </aapt:attr>
    </target>
    <target android:name="arc1">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:valueFrom="0.2" android:valueTo="1"
                android:valueType="floatType" android:startOffset="270" android:duration="420" />
        </aapt:attr>
    </target>
    <target android:name="arc2">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:valueFrom="0.2" android:valueTo="1"
                android:valueType="floatType" android:startOffset="540" android:duration="420" />
        </aapt:attr>
    </target>
    <target android:name="arc3">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:valueFrom="0.2" android:valueTo="1"
                android:valueType="floatType" android:startOffset="810" android:duration="420" />
        </aapt:attr>
    </target>
</animated-vector>
